{
  "name": "yummacss-css-play",
  "version": "0.0.0",
  "description": "Yumma CSS Play with Sandpack.",
  "homepage": "https://yummacss.com",
  "license": "MIT",
  "author": "Renildo Pereira",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "prettier --write .",
    "build": "next build && yummacss build",
    "dev": "concurrently \"next dev --turbopack\" \"yummacss watch\"",
    "lint": "next lint",
    "release": "pnpm up yummacss @yummacss/api --latest",
    "start": "next start"
  },
  "packageManager": "pnpm@10.15.0",
  "dependencies": {
    "@codemirror/view": "^6.38.0",
    "@codesandbox/sandpack-react": "^2.18.2",
    "@monaco-editor/react": "^4.7.0",
    "@vercel/speed-insights": "^1.2.0",
    "@yummacss/api": "^1.6.2",
    "emmet-monaco-es": "^5.5.0",
    "next": "^15.2.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-resizable-panels": "^2.1.7"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "concurrently": "^9.1.2",
    "eslint": "^8",
    "eslint-config-next": "14.2.5",
    "prettier-plugin-organize-imports": "^4.2.0",
    "typescript": "^5",
    "yummacss": "^3.4.3"
  }
}
