{
  "name": "yummacss-css-play",
  "version": "0.0.0",
  "description": "A playground for Yumma CSS.",
  "homepage": "https://yummacss.com",
  "license": "MIT",
  "author": "Renildo Pereira",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build && yummacss build",
    "dev": "concurrently \"next dev --turbopack\" \"yummacss watch\"",
    "lint": "biome check --write .",
    "release": "pnpm up yummacss @yummacss/api --latest",
    "start": "next start"
  },
  "packageManager": "pnpm@10.20.0",
  "dependencies": {
    "@codemirror/view": "^6.39.2",
    "@codesandbox/sandpack-react": "^2.20.0",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-icons": "^1.3.2",
    "@upstash/redis": "^1.35.7",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "@yummacss/api": "^1.7.2",
    "emmet-monaco-es": "^5.6.1",
    "ky": "^1.14.1",
    "next": "^16.0.8",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-resizable-panels": "^3.0.6",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.8",
    "@types/node": "^24.10.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3",
    "yummacss": "^3.5.0"
  }
}
