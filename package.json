{
  "name": "yummacss-play",
  "version": "0.0.0",
  "private": true,
  "description": "Yumma CSS playground",
  "homepage": "https://yummacss.com",
  "license": "MIT",
  "author": "Renildo Pereira",
  "type": "module",
  "scripts": {
    "build": "next build && yummacss build",
    "dev": "concurrently \"next dev --turbopack\" \"yummacss watch\"",
    "lint": "biome check --write .",
    "sort": "sort-package-json",
    "start": "next start",
    "update-yummacss": "pnpm up yummacss @yummacss/core --latest"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@monaco-editor/react": "^4.7.0",
    "@react-symbols/icons": "^1.3.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/kv": "^3.0.0",
    "@vercel/speed-insights": "^2.0.0",
    "@yummacss/intellisense": "^3.24.15",
    "emmet-monaco-es": "^5.7.0",
    "iconoir-react": "^7.11.0",
    "lz-string": "^1.5.0",
    "motion": "^12.40.0",
    "next": "^16.2.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-icons": "^5.6.0",
    "react-resizable-panels": "^3.0.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@types/lz-string": "^1.5.0",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^9.2.1",
    "sort-package-json": "^3.6.1",
    "typescript": "^6.0.3",
    "yummacss": "^3.24.15"
  },
  "packageManager": "pnpm@10.32.1"
}