{
  "name": "yummacss-play",
  "version": "0.0.0",
  "private": true,
  "description": "Yumma CSS playground",
  "homepage": "https://yummacss.com",
  "license": "MIT",
  "author": "Renildo Pereira",
  "type": "module",
  "scripts": {
    "build": "next build && yummacss build",
    "dev": "concurrently \"next dev --turbopack\" \"yummacss watch\"",
    "lint": "biome check --write .",
    "sort": "sort-package-json",
    "start": "next start",
    "update-yummacss": "pnpm up yummacss @yummacss/core --latest"
  },
  "dependencies": {
    "@base-ui/react": "^1.1.0",
    "@codemirror/view": "^6.39.8",
    "@monaco-editor/react": "^4.7.0",
    "@phosphor-icons/react": "^2.1.10",
    "@react-symbols/icons": "^1.3.0",
    "@vercel/analytics": "^1.6.1",
    "@vercel/kv": "^3.0.0",
    "@vercel/speed-insights": "^1.3.1",
    "@yummacss/intellisense": "^3.24.3",
    "emmet-monaco-es": "^5.6.1",
    "lz-string": "^1.5.0",
    "next": "^16.1.7",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-icons": "^5.5.0",
    "react-resizable-panels": "^3.0.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.10",
    "@types/lz-string": "^1.5.0",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^9.2.1",
    "sort-package-json": "^3.6.1",
    "typescript": "^5.9.3",
    "yummacss": "^3.24.3"
  },
  "packageManager": "pnpm@10.32.1"
}