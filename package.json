{
  "name": "yumma-css-playground",
  "version": "1.0.0",
  "description": "A playground for Yumma CSS.",
  "homepage": "https://yummacss.com",
  "license": "MIT",
  "author": "Renildo Pereira",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build && yummacss build",
    "dev": "concurrently \"next dev --turbopack\" \"yummacss watch\"",
    "lint": "biome check --write .",
    "release": "pnpm up yummacss @yummacss/api --latest",
    "start": "next start"
  },
  "packageManager": "pnpm@10.27.0",
  "dependencies": {
    "@codemirror/view": "^6.39.8",
    "@codesandbox/sandpack-react": "^2.20.0",
    "@monaco-editor/react": "^4.7.0",
    "@phosphor-icons/react": "^2.1.10",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "@yummacss/api": "^3.8.1",
    "emmet-monaco-es": "^5.6.1",
    "lz-string": "^1.5.0",
    "next": "^16.1.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-resizable-panels": "^3.0.6",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.10",
    "@types/lz-string": "^1.5.0",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3",
    "yummacss": "^3.8.1"
  }
}
